# 运行时生成（配置 / 用量统计，含端口与出口代理信息，不入库）
config.json
stats.json
# 例外：Android 侧这份是随包发布的"首次启动默认配置"，必须入库。
# 没有它，getAssets().open("config.json") 抛 FileNotFoundException，代理进程永远起不来
# （CI 全绿但装到手机上启动失败，2026-10-17 真机实测踩过）。
!android/app/src/main/assets/config.json

# 构建产物
opencode2api-lite
opencode2api-lite.exe
dist/

# 本地临时
*.log
.DS_Store

# ── Android ──
# Gradle / AGP 产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# 交叉编译产物：由 CI 生成后铺进 jniLibs，不入库
android/app/src/main/jniLibs/*/*.so

# 签名材料一律不入库（CI 走 secrets 或临时自签）
*.keystore
*.jks
